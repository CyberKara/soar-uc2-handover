                        "type": "prompt",
                        "message": "**TRAP Incident {0}**\nContainer: {1}\n\nClosing this incident will close it in Proofpoint TRAP and post your closure reason as a comment. Provide a closure reason.",
                        "advanced": {
                            "join": [],
                            "note": "Approver: container_owner, falls back to soar_local_admin. 30min timeout.",
                            "customName": "prompt close reason",
                            "description": "Prompt analyst for a closure reason.",
