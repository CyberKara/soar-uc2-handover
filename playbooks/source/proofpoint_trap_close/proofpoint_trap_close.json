                        "parameters": [
                            "extract_incident_id:custom_function:incident_id",
                            "container:name"
                        ],
                        "functionName": "prompt_close_reason",
                        "responseTime": 30,
                        "hasExternalApprover": false
                    },
                    "type": "prompt",
