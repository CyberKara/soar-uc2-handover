                    "data": {
                        "id": "9",
                        "type": "code",
                        "advanced": {
                            "join": [],
                            "note": "Reads incident_id (+ trap_severity where used) from the extract_incident_id CF result.",
                            "customName": "read incident id",
                            "description": "Bridge block: read extract_incident_id CF result (same pattern as cyberark_rotation_orchestrator.py read_discover_result).",
                            "customNameId": 0
                        },
                        "functionId": 8,
                        "functionName": "read_incident_id",
                        "inputParameters": [
                            "extract_incident_id:custom_function_result.data.incident_id"
                        ],
                        "outputVariables": [
                            "incident_id"
                        ]
                    },
                    "type": "code",
                    "errors": {},
                    "userCode": "    ################################################################################\n\n    result_rows = phantom.collect2(\n        container=container,\n        datapath=[\"extract_incident_id:custom_function_result.data.incident_id\"],\n    )\n    incident_id_val = result_rows[0][0] if result_rows else None\n\n    if not incident_id_val:\n        phantom.error(\"Could not find Incident ID (cef.incidentId) on the 'Event Info' artifact\")\n        phantom.add_note(\n            container=container,\n            note_type=\"general\",\n            title=\"TRAP Acknowledge - Error\",\n            content=\"Could not find Incident ID on the 'Event Info' artifact\"\n        )\n        return\n\n    read_incident_id__incident_id = str(incident_id_val)\n    phantom.debug(\"Extracted incident ID: {}\".format(read_incident_id__incident_id))\n\n    ################################################################################\n"
                }
