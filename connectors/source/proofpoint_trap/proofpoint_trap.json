    "product_vendor": "Proofpoint",
    "product_name": "Threat Response Auto-Pull",
    "product_version_regex": ".*",
    "logo": "logo.svg",
    "logo_dark": "logo_dark.svg",
    "publisher": "Ted",
    "license": "Copyright (c) 2026",
    "app_version": "1.0.34",
    "utctime_updated": "2026-08-20T00:00:00.000000Z",
    "package_name": "phantom_proofpoint_trap",
    "main_module": "proofpoint_trap_connector.py",
    "min_phantom_version": "6.4.1",
    "app_wizard_version": "1.0.0",
    "python_version": "3.13",
    "pip_dependencies": {
        "wheel": []
    },
    "configuration": {
        "base_url": {
            "description": "Proofpoint TRAP base URL (e.g. https://trap.example.com)",
            "data_type": "string",
            "required": true,
            "order": 0
        },
        "api_key": {
            "description": "API key for authentication (generate in TRAP > System Settings > API Keys)",
            "data_type": "password",
            "required": true,
            "order": 1
        },
        "verify_ssl": {
            "description": "Verify server SSL certificate",
            "data_type": "boolean",
            "required": false,
            "default": true,
            "order": 2
        },
        "timeout": {
            "description": "Request timeout in seconds (default: 60)",
            "data_type": "numeric",
            "required": false,
            "default": 60,
            "order": 3
        },
        "ph_poll": {
            "data_type": "ph",
            "order": 4
        },
        "poll_state": {
            "description": "TRAP incident state to poll. Valid: new, open, closed",
            "data_type": "string",
            "required": false,
            "default": "new",
            "order": 5
        },
        "abuse_disposition": {
            "description": "Comma-separated Abuse Disposition values to ingest. Valid: Malicious, Suspicious, Spam, Bulk, Low Risk, False Negative, Known Good, Unknown",
            "data_type": "string",
            "required": false,
            "default": "Unknown",
            "order": 6
        },
        "sub_disposition": {
            "description": "Comma-separated Sub Disposition values to ingest, applied in addition to abuse_disposition. Valid: Needs Manual Review, Likely Harmless. Only meaningful when abuse_disposition includes Unknown.",
            "data_type": "string",
            "required": false,
            "default": "",
            "order": 7
        },
        "poll_hours": {
            "description": "How many hours back to poll on first run",
            "data_type": "numeric",
            "required": false,
            "default": 1,
            "order": 8
        },
        "severity": {
            "description": "Initial severity of the created container (promoted later by proofpoint_trap_triage from the real TRAP Severity field)",
            "data_type": "string",
            "required": false,
            "default": "low",
            "order": 9
        },
        "sensitivity": {
            "description": "Sensitivity of the created container",
            "data_type": "string",
            "required": false,
            "value_list": ["white", "green", "amber", "red"],
            "default": "amber",
            "order": 10
        }
    },
