                    "default": 1,
                    "order": 1
                },
                "abuse_disposition": {
                    "description": "Comma-separated Abuse Disposition values to filter to. Valid: Malicious, Suspicious, Spam, Bulk, Low Risk, False Negative, Known Good, Unknown. Leave blank for any",
